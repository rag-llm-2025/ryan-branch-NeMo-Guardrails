{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug python (current file)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}${env:PYTHONPATH}"
            }
        },
        {
            "name": "Debug story verbose (current directory)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "nemoguardrails",
            "args": ["chat", "--config=${fileDirname}", "--debug-level=DEBUG"],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}${env:PYTHONPATH}"
            }
        },
        {
            "name": "Debug story (current directory)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "nemoguardrails",
            "args": ["chat", "--config=${fileDirname}", "--debug-level=INFO"],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}${env:PYTHONPATH}"
            }
        },
        {
            "name": "Run story verbose (current directory)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "nemoguardrails",
            "args": ["chat", "--config=${fileDirname}", "--verbose"],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}${env:PYTHONPATH}"
            }
        },
        {
            "name": "Run story (current directory)",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "nemoguardrails",
            "args": ["chat", "--config=${fileDirname}"],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}${env:PYTHONPATH}"
            }
        },
        {
            "name": "Run mypy",
            "type": "debugpy",
            "request": "launch",
            "program": "",
            "console": "integratedTerminal",
            "preLaunchTask": "Run mypy"
        },
        {
            "name": "Debug Ryan Bot Server",
            "type": "debugpy",
            "request": "launch",
            "module": "nemoguardrails",
            "args": [
                "server",
                "--config=./ryan_bot/config",
                "--disable-chat-ui",
                "--default-config-id=qwen_model",
                "--verbose"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}${env:PYTHONPATH}",
                "PROMPTS_DIR": "./ryan_bot/config/prompts"
            },
            // 指定虚拟环境的 Python 解释器路径
            // "python": "/root/ryan/llm/src/nemo-guardrails/venv/bin/python"
        },
        {
            "name": "Debug Ryan Bot Chat",
            "type": "debugpy",
            "request": "launch",
            "module": "nemoguardrails",
            "args": [
                "chat",
                "--config=./ryan_bot/config",
                "--default-config-id=qwen_model",
                "--streaming"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug VLLM Qwen Runner",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ryan_bot/config/vllm_qwen/demo.py",
            // "args": ["--host", "${env:HOST}", "--port", "${env:PORT}"],
            "args": ["--host", "gn101.crg.cerence.net", "--port", "8010"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "HOST": "gn101.crg.cerence.net",
                "PORT": "8010",
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}${env:PYTHONPATH}",
                "OPENAI_API_KEY": "${env:OPENAI_API_KEY}",
                "OPENAI_BASE_URL": "${env:OPENAI_BASE_URL}",
                "OPENAI_URL_AUTH": "${env:OPENAI_URL_AUTH}"
            }
        },
    ]
}
