import core
import avatars
import timing
import llm

flow main
  activate automating intent detection
  activate generating user intent for unhandled user utterance

  while True
    when unhandled user intent
      # bot inform say again
      $response = ..."Response to what user said."
      bot say $response
    or when user was silent 12.0
      bot inform about service
    or when user expressed greeting
      bot say "Hi there!"
    or when user expressed goodbye
      bot inform "That was fun. Goodbye"
    or when user ask about price
      $price = execute get_product_price(product_name=$user_message)
      bot provide price info with $price

# 新增价格查询相关flow定义
flow user ask about price
  user said "这个多少钱"
    or user said "价格是多少"
    or user said "how much is this"
    or user said "what is the price"

flow bot provide price info with $price
  bot say "产品价格是：$price"
    or bot say "查询到的价格是：$price"
    or bot say "这个产品的价格是：$price"

flow user expressed greeting
  user said "hi"
    or user said "hello"

flow user expressed goodbye
  user said "goodbye"
    or user said "I am done"
    or user said "I have to go"

flow bot inform about service
  bot say "You can ask me anything!"
    or bot say "Just ask me something!"

flow bot inform say again
  bot say "Sorry, please say again"
    or bot say "Sorry, I can't hear you clearly, please say again"
