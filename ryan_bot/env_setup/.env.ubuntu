# internet
API_KEY=test_key
API_SECRET=test_secret

HOST=0.0.0.0
PORT=8000

# development
DEBUG=True
PRJ_ENV=development
RYAN_LOGGER_LEVEL=DEBUG
CLI_LOGGER_LEVEL=DEBUG
NEMO_LOGGER_LEVEL=DEBUG

# nemo guardrails config
LLM_DIR=/home/ubuntu/workspace/llm
# Qwen2.5-7B-Instruct or Qwen2.5-7B-Instruct
MODEL_NAME=Qwen2_BE_0.6B
MODEL_PATH=${LLM_DIR}/models/${MODEL_NAME}
CHECKPOINT_PATH=""
# ryan_local_engine or ryan_vllm_engine
ENGINE_NAME=ryan_local_engine
# DEVICE value should be retrived from setup_env_ryan_bot.sh
DEVICE=cpu

# feature toggles
STREAM=False
ENABLE_VLLM=True
ENABLE_TEXT_EMBEDDING=False
ENABLE_LATENCY_OPTIMIZATION=True