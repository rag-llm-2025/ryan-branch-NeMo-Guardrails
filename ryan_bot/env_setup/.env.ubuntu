# internet
API_KEY=test_key
API_SECRET=test_secret

HOST=0.0.0.0
PORT=8000

# development
DEBUG=True
PRJ_ENV=development
RYAN_LOGGER_LEVEL=INFO
CLI_LOGGER_LEVEL=INFO
TEST_LOGGER_LEVEL=ERROR

# nemo guardrails config
LLM_DIR=/home/ubuntu/workspace/llm
MODEL_NAME=Qwen2_BE_0.6B                                                    # Qwen2.5-7B-Instruct or Qwen2.5-7B-Instruct
MODEL_PATH="${LLM_DIR:-~/workspace/llm}/models/${MODEL_NAME:-Qwen2_BE_0.6B}"
ENGINE_NAME=ryan_local_engine                                               # ryan_local_engine or ryan_vllm_engine
DEVICE=cpu

# feature toggles
STREAM=True
ENABLE_VLLM=True
ENABLE_TEXT_EMBEDDING=False
ENABLE_LATENCY_OPTIMIZATION=True